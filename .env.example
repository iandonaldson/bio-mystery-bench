# Copy this to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=your-key-here

# Optional: HuggingFace token (required for the full 99-problem dataset)
# The preview dataset (5 problems) is public and does not require a token.
HF_TOKEN=

# Alternative providers
OPENAI_API_KEY=
# Groq: fast cloud inference (use with --provider groq)
GROQ_API_KEY=
# Ollama: no key required; set base URL if not using the default port
OLLAMA_BASE_URL=http://localhost:11434/v1
