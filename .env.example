# Copy this to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=your-key-here

# Optional: HuggingFace token (required for the full 99-problem dataset)
# The preview dataset (5 problems) is public and does not require a token.
HF_TOKEN=

# Alternative providers
OPENAI_API_KEY=

# Groq: fast cloud inference, OpenAI-compatible (use with --provider groq)
GROQ_API_KEY=

# Cerebras: fast cloud inference, 1M tokens/day free tier
# Use with: --provider openai --api-base-url https://api.cerebras.ai/v1 --api-key $CEREBRAS_API_KEY
CEREBRAS_API_KEY=

# Azure AI Foundry: open-source models (Phi-4, Llama, Mistral) via pay-per-token serverless API
# Endpoint URL is project-specific — copy from https://ai.azure.com after deploying a model
# Use with: --provider azure --api-base-url https://<project>.<region>.models.ai.azure.com
AZURE_AI_API_KEY=

# Ollama: local open-source models, no key required
# Use with: --provider ollama --model <model-name>
OLLAMA_BASE_URL=http://localhost:11434/v1

# Tavily research
TAVILY_API_KEY=
